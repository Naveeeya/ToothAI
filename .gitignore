# ============================================
# Tooth-AI .gitignore - Production Ready
# ============================================

# === VIRTUAL ENVIRONMENTS ===
venv/
.venv/
env/
.env

# === PYTHON CACHE ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/

# === DATASET (Large - 2GB+) ===
data/
!data/.gitkeep

# === WANDB LOGS (10GB+) ===
wandb/

# === OUTPUT CHECKPOINTS ===
# Exclude all intermediate checkpoints
output/*/model_0*.pth
output/*/last_checkpoint
output/*/events.out.*
output/inference/
output/*/instances_predictions.pth

# Keep only final models and configs
!output/*/model_final.pth
!output/*/config.yaml

# === TEMPORARY & BACKUP ===
*.bak
*.tmp
*.log
*.swp
*~

# === IDE ===
.vscode/
.idea/
*.code-workspace

# === OS FILES ===
.DS_Store
Thumbs.db
Desktop.ini

# === BUILD ARTIFACTS ===
build/
dist/

# === JUPYTER ===
.ipynb_checkpoints/
*.ipynb
!paper_eval/kaggle/*.ipynb

# === ANNOTATIONS BACKUP ===
*_annotations.coco.json.bak
**/model_final.pth
# === GRAPHIFY KNOWLEDGE GRAPH (generated; .graphifyignore stays tracked) ===
graphify-out/

# === macOS AppleDouble files (external drive) ===
._*

# === PHOTO SCREENING ===
!photo_screening/notebooks/*.ipynb
photo_screening/notebooks/._*
photo_screening/weights/*
!photo_screening/weights/README.md
photo_screening/.smoke/
photo_screening/samples/*
!photo_screening/samples/README.md
photo_screening/.env

# === GENERATED OUTPUTS (may hold patient-derived images or test-image names) ===
output/*.txt
output/*.json
output/best_anomaly_images/
output/rank1_reports/
paper_eval/kaggle/bundle/
paper_eval/kaggle/bundle_code/
ap_summary.json

# === LOCAL TOOLING ===
.claude/

# === paper_eval outputs that hold test-image names or embedded radiographs: local only ===
paper_eval/results/label_quality.csv
paper_eval/results/panel_candidates.csv
paper_eval/review/

# === paper_eval model-output cache (numeric ids only; regenerate with cache_outputs.py) ===
paper_eval/.cache/

# deploy/push.sh image archives
.deploy/

# presentation media built by tools/report_media (screenshots, PDFs)
/report_media/
