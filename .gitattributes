# Text files are stored with LF; checkouts use LF on every OS.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never converted or diffed as text.
*.pt binary
*.onnx binary
*.pkl binary
*.npy binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.heic binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Model checkpoints go through Git LFS (kept from the original file; must stay last).
*.pth filter=lfs diff=lfs merge=lfs -text
output/**/*.pth filter=lfs diff=lfs merge=lfs -text
