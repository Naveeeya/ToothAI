# Tooth-AI Photo Screening settings. Copy to photo_screening/.env (git-ignored) or export as environment variables.

# Models
PHOTO_DEVICE=auto                 # auto | mps | cpu | cuda:0
PHOTO_ALPHADENT_VARIANT=4c960     # 4c960 | 9c640 | 9c960
# PHOTO_ALPHADENT_IMGSZ=960       # defaults to the variant's training size
PHOTO_TTA=false                   # horizontal-flip test-time augmentation (doubles inference time)
# PHOTO_WEIGHTS_DIR=photo_screening/weights
# PHOTO_THRESHOLDS_JSON=          # optional per-type threshold overrides

# Uploads and quality gate
PHOTO_MAX_UPLOAD_MB=15
PHOTO_MIN_SIDE_PX=480
PHOTO_BLUR_MIN_VAR=20             # Laplacian variance at 640 px

# Optional AI observations (off by default; the template summary always works offline)
PHOTO_VLM_ENABLED=false
PHOTO_VLM_BASE_URL=http://localhost:11434/v1     # local Ollama (no data leaves the machine)
PHOTO_VLM_MODEL=qwen2.5vl:3b
PHOTO_VLM_API_KEY=
PHOTO_VLM_PROVIDER_LABEL=Ollama (local)
PHOTO_VLM_MAX_IMAGES=1
PHOTO_VLM_TIMEOUT_S=90
# Gemini Flash instead (photos are then sent to Google and the UI says so):
# PHOTO_VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# PHOTO_VLM_MODEL=<a Gemini Flash model id>
# PHOTO_VLM_API_KEY=<your key>
# PHOTO_VLM_PROVIDER_LABEL=Google Gemini

# Links in the PDF (QR code to the OPG page)
PHOTO_APP_URL=http://localhost:8501

# Streamlit side (where the page finds the API)
PHOTO_API_URL=http://localhost:8001
